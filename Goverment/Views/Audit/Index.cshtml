@model IEnumerable<Goverment.Models.Audit>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid mt-4">
    <h2 class="fw-bold text-danger mb-4"><i class="fas fa-clipboard-list me-2"></i>System Audit Logs</h2>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>Audit ID</th>
                            <th>Date</th>
                            <th>Scope</th>
                            <th>Officer</th>
                            <th>Status</th>
                            <th>Findings</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var audit in Model) {
                            <tr>
                                <td><strong>#@audit.AuditID</strong></td>
                                <td>@audit.Date.ToShortDateString()</td>
                                <td><span class="text-uppercase small fw-bold">@audit.Scope</span></td>
                                <td>@audit.Officer?.Name</td>
                                <td>
                                    @if(audit.Status == "Flagged") {
                                        <span class="text-danger"><i class="fas fa-exclamation-triangle"></i> @audit.Status</span>
                                    } else {
                                        <span class="text-success">@audit.Status</span>
                                    }
                                </td>
                                <td><small class="text-muted">@audit.Findings</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>