@{
    ViewData["Title"] = "TradeNet | Professional Government Portal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/tradenet.css">
</head>
<body>

    <nav class="navbar navbar-expand-lg fixed-top py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center fw-bold" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="Logo" height="40" class="me-2 nav-logo">
                TradeNet
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link px-3" href="#home">Home</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="#about">About</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="#services">Services</a></li>
                    <li class="nav-item ms-lg-3">
                        <button class="btn btn-login-toggle fw-600 rounded-pill px-4 me-2" data-bs-toggle="modal"
                                data-bs-target="#loginModal">Login</button>
                        <a class="btn btn-primary fw-600 rounded-pill px-4" asp-controller="Account" asp-action="Register">Register</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <section id="home" class="hero-section text-white text-center">
        <div class="container">
            <h1 class="display-3 fw-bold mb-4">Trade Without <span class="text-warning">Boundaries</span></h1>
            <p class="lead mb-5 opacity-75 mx-auto" style="max-width: 700px;">
                Streamlining business registration and global trade compliance through a unified digital gateway.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <button class="btn btn-success btn-lg px-5 rounded-pill shadow" data-bs-toggle="modal" data-bs-target="#loginModal">Apply Now</button>
                <button class="btn btn-outline-light btn-lg px-5 rounded-pill">View Guidelines</button>
            </div>
        </div>
    </section>

    <section id="about" class="py-5 my-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <h6 class="text-primary fw-bold text-uppercase">Who We Are</h6>
                    <h2 class="fw-bold mb-4">Driving Economic Excellence</h2>
                    <p class="text-muted mb-4">TradeNet is the backbone of national commerce. We provide entrepreneurs
                        with the tools to register, license, and verify trade credentials in a secure, transparent
                        environment.</p>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Real-time license
                            processing</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> 100% Digital
                            documentation</li>
                    </ul>
                </div>
                <div class="col-lg-6">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&w=800&q=80"
                             class="img-fluid rounded-4 shadow-lg" alt="Global Logistics">
                        <div class="position-absolute bottom-0 start-0 m-3 bg-white p-2 rounded shadow-sm">
                            <p class="mb-0 small fw-bold text-primary"><i class="fas fa-check-double"></i> Verified
                                Portal</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="services" class="py-5">
        <div class="container py-5">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-tn-blue display-5">WHAT WE OFFER</h2>
                <div class="mx-auto bg-primary" style="height: 4px; width: 60px; margin-top: 15px;"></div>
            </div>

            <div class="row service-row justify-content-center">
                <div class="col-md-4">
                    <div class="card service-card card-blue shadow-sm">
                        <div class="icon-box">
                            <i class="fas fa-file-invoice"></i>
                        </div>
                        <h5 class="fw-bold">Quick Registration</h5>
                        <p class="mb-0">Complete your business setup in under 24 hours with our automated workflow.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card service-card card-white shadow-sm">
                        <div class="icon-box">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h5 class="fw-bold">Audit & Compliance</h5>
                        <p class="mb-0">Stay verified with our integrated compliance tracking and reporting system.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card service-card card-blue shadow-sm">
                        <div class="icon-box">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h5 class="fw-bold">Trade Analytics</h5>
                        <p class="mb-0">Access real-time insights and market trends to grow your business
                            internationally.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card service-card card-white shadow-sm">
                        <div class="icon-box">
                            <i class="fas fa-certificate"></i>
                        </div>
                        <h5 class="fw-bold">Digital Licensing</h5>
                        <p class="mb-0">Manage import/export permits through our secure digital vault.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card service-card card-blue shadow-sm">
                        <div class="icon-box">
                            <i class="fas fa-globe"></i>
                        </div>
                        <h5 class="fw-bold">Global Logistics</h5>
                        <p class="mb-0">Connect with verified shipping partners and track cargo across 150+ countries.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card service-card card-white shadow-sm">
                        <div class="icon-box">
                            <i class="fas fa-credit-card"></i>
                        </div>
                        <h5 class="fw-bold">Secure Payments</h5>
                        <p class="mb-0">Facilitate cross-border transactions with government-backed escrow services.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-tn-blue text-white py-5">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4 my-3">
                    <h2 class="fw-bold display-5 mb-0">12k+</h2>
                    <p class="text-white-50">Active Businesses</p>
                </div>
                <div class="col-md-4 my-3">
                    <h2 class="fw-bold display-5 mb-0">98%</h2>
                    <p class="text-white-50">Customer Satisfaction</p>
                </div>
                <div class="col-md-4 my-3">
                    <h2 class="fw-bold display-5 mb-0">24/7</h2>
                    <p class="text-white-50">Online Support</p>
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-dark text-white pt-5 pb-3">
        <div class="container text-center">
            <div class="mb-4">
                <img src="~/images/logo.png" alt="Footer Logo" height="30" class="mb-3 opacity-75">
                <h5 class="fw-bold">TradeNet</h5>
                <p class="text-white-50 small">Empowering Commerce. Building Futures.</p>
            </div>
            <hr class="border-secondary">
            <p class="small text-white-50">&copy; 2026 TradeNet Government. All Rights Reserved.</p>
        </div>
    </footer>

    <!-- Login Modal -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-5 pt-0">
                    <div class="text-center mb-4">
                        <img src="~/images/logo.png" alt="Logo" height="40" class="mb-3">
                        <h5 class="fw-bold text-tn-blue">Trader Login</h5>
                        <p class="text-muted small">Access your TradeNet account</p>
                    </div>
                    <form asp-controller="Account" asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Email Address</label>
                            <input type="email" name="email" class="form-control rounded-3 py-2" placeholder="your@email.com" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Password</label>
                            <input type="password" name="password" class="form-control rounded-3 py-2"
                                   placeholder="Enter your password" required>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe">
                                <label class="form-check-label small" for="rememberMe">Remember me</label>
                            </div>
                        </div>
                        <button type="submit"
                                class="btn btn-primary w-100 rounded-pill py-2 shadow-sm fw-bold mb-3">Login</button>
                    </form>
                    <div class="text-center">
                        <p class="small text-muted">Don't have an account? <a asp-controller="Account" asp-action="Register"
                                                                               class="text-tn-blue fw-bold text-decoration-none">Register here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.onscroll = function () {
            var nav = document.querySelector('.navbar');
            if (window.pageYOffset > 50) {
                nav.classList.add('navbar-scrolled');
            } else {
                nav.classList.remove('navbar-scrolled');
            }
        };
    </script>
</body>
</html>
