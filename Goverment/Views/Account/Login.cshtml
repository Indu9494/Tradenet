@model Goverment.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login | TradeNet";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/tradenet.css" />
</head>
<body>

    <div class="login-container">
        <div class="login-card">
            <div class="card shadow-lg border-0 rounded-4 p-5">
                <div class="text-center mb-5">
                    <img src="~/images/logo.png" alt="Logo" height="50" class="mb-3">
                    <h4 class="fw-bold text-tn-blue">Trader Login</h4>
                    <p class="text-muted small">Access your TradeNet account</p>
                </div>

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="@ViewData["ReturnUrl"]" />

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label small fw-bold">Email Address</label>
                        <input asp-for="Email" class="form-control rounded-3 py-2" placeholder="your@email.com" required>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-bold">Password</label>
                        <input asp-for="Password" class="form-control rounded-3 py-2" placeholder="Enter your password" required>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                            <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 shadow-sm fw-bold">Login</button>
                </form>
                <div class="text-center mt-5">
                    <p class="small text-muted">Don't have an account? <a asp-action="Register" asp-controller="Account" class="text-tn-blue fw-bold text-decoration-none">Register here</a></p>
                    <p class="small"><a asp-action="Index" asp-controller="Home" class="text-muted text-decoration-none">← Back to Home</a></p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
