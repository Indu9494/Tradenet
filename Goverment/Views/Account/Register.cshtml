@model Goverment.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register | TradeNet";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/tradenet.css" />
</head>
<body>

    <div class="register-container">
        <div class="register-card">
            <div class="card shadow-lg border-0 rounded-4 p-5">
                <div class="text-center mb-5">
                    <img src="~/images/logo.png" alt="Logo" height="50" class="mb-3">
                    <h4 class="fw-bold text-tn-blue">Create Trader Account</h4>
                    <p class="text-muted small">Start your trade journey in seconds</p>
                </div>

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Register" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-bold">Full Name</label>
                            <input asp-for="FullName" class="form-control rounded-3 py-2" placeholder="Enter your full name" required>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BusinessName" class="form-label small fw-bold">Business Name</label>
                            <input asp-for="BusinessName" class="form-control rounded-3 py-2" placeholder="Company Name e.g. ABC Ltd" required>
                            <span asp-validation-for="BusinessName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-bold">Official Email</label>
                            <input asp-for="Email" class="form-control rounded-3 py-2" placeholder="work@company.com" required>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-bold">Password</label>
                            <input asp-for="Password" class="form-control rounded-3 py-2" placeholder="Create a strong password" required>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-12">
                            <label asp-for="ConfirmPassword" class="form-label small fw-bold">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control rounded-3 py-2" placeholder="Confirm your password" required>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-12">
                            <label asp-for="Role" class="form-label small fw-bold">Register As</label>
                            <select asp-for="Role" class="form-control rounded-3 py-2">
                                <option value="Business">Business/Trader</option>
                                <option value="Auditor">Government Auditor</option>
                                <option value="Officer">Trade Officer</option>
                                <option value="Compliance">Compliance Officer</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-4 form-check mt-3">
                        <input asp-for="AgreeTerms" class="form-check-input" type="checkbox" required>
                        <label asp-for="AgreeTerms" class="form-check-label small">
                            I agree to the <a href="#" class="text-tn-blue text-decoration-none">Terms & Conditions</a>
                        </label>
                        <span asp-validation-for="AgreeTerms" class="text-danger small d-block"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 shadow-sm fw-bold">Register & Continue</button>
                </form>
                <div class="text-center mt-5">
                    <p class="small text-muted">Already have an account? <a asp-action="Login" asp-controller="Account" class="text-tn-blue fw-bold text-decoration-none">Login here</a></p>
                    <p class="small"><a asp-action="Index" asp-controller="Home" class="text-muted text-decoration-none">← Back to Home</a></p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
