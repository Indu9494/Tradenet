@model IEnumerable<Goverment.Models.Business>
@{
    Layout = null;
    ViewData["Title"] = "Investigation Hub";

    // Dummy data if model is null or empty
    var dummyBusinesses = new List<dynamic>
    {
        new { BusinessID = 1, Name = "ABC Trading Co.", Type = "Exporter", Address = "123 Business St, New York, NY", ContactInfo = "contact@abctrading.com | +1-555-0101", Status = "Active" },
        new { BusinessID = 2, Name = "XYZ Imports Ltd.", Type = "Importer", Address = "456 Commerce Ave, Los Angeles, CA", ContactInfo = "info@xyzimports.com | +1-555-0102", Status = "Active" },
        new { BusinessID = 3, Name = "Global Traders Inc.", Type = "Trader", Address = "789 Trade Blvd, Chicago, IL", ContactInfo = "support@globaltraders.com | +1-555-0103", Status = "Active" },
        new { BusinessID = 4, Name = "Local Market Supply", Type = "Trader", Address = "321 Market St, Houston, TX", ContactInfo = "sales@localsupply.com | +1-555-0104", Status = "Active" },
        new { BusinessID = 5, Name = "Tech Import Solutions", Type = "Importer", Address = "999 Tech Drive, San Francisco, CA", ContactInfo = "hello@techimports.com | +1-555-0106", Status = "Active" }
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/tradenet.css">
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #003566 0%, #001d3d 100%);
            color: white;
        }
        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.8);
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: all 0.3s;
        }
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
        }
    </style>
</head>
<body class="bg-light" style="overflow-x: hidden;">

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <nav class="col-md-2 d-md-block sidebar p-3 position-fixed" style="height: 100vh; left: 0; top: 0; z-index: 100; overflow-y: hidden;">
                <div class="text-center mb-3 pb-2 border-bottom border-secondary">
                    <h5 class="fw-bold">TradeNet</h5>
                    <p class="small mb-0 text-white-50">Government Auditor</p>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AuditorDashboard" asp-action="Index">
                            <i class="fas fa-chart-line me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="AuditorDashboard" asp-action="InvestigationHub">
                            <i class="fas fa-search me-2"></i> Investigation Hub
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AuditorDashboard" asp-action="ComplianceReview">
                            <i class="fas fa-clipboard-check me-2"></i> Compliance Review
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AuditorDashboard" asp-action="SubsidyTracking">
                            <i class="fas fa-money-bill-wave me-2"></i> Subsidy Tracking
                        </a>
                    </li>
                    <li class="nav-item mt-4">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="nav-link btn btn-link text-start w-100">
                                <i class="fas fa-sign-out-alt me-2"></i> Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </nav>

            <!-- Main Content -->
            <main class="col-md-10 offset-md-2 px-4 py-3" style="margin-left: 16.666667%; width: 83.333333%; max-height: 100vh; overflow-y: auto;">
                <div class="mb-3">
                    <h2 class="fw-bold text-primary">Investigation Hub</h2>
                    <p class="text-muted mb-0">Research business history, licenses, transactions, and audit logs</p>
                </div>

                <!-- Search Form -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-search me-2"></i> Search Entity Records
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-controller="AuditorDashboard" asp-action="SearchInvestigation" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Search Type</label>
                                    <select class="form-select" name="searchType" required>
                                        <option value="">Select Type</option>
                                        <option value="BusinessID">Business ID</option>
                                        <option value="LicenseID">License ID</option>
                                        <option value="TransactionID">Transaction ID</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Search Value</label>
                                    <input type="text" class="form-control" name="searchValue" placeholder="Enter ID" required>
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fas fa-search me-2"></i> Search
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Quick Access Buttons -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <a asp-controller="Business" asp-action="Index" class="btn btn-outline-primary w-100 py-3">
                            <i class="fas fa-building d-block mb-2" style="font-size: 24px;"></i>
                            All Businesses
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-controller="TradeLicense" asp-action="Index" class="btn btn-outline-success w-100 py-3">
                            <i class="fas fa-certificate d-block mb-2" style="font-size: 24px;"></i>
                            All Licenses
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-controller="Transaction" asp-action="Index" class="btn btn-outline-warning w-100 py-3">
                            <i class="fas fa-exchange-alt d-block mb-2" style="font-size: 24px;"></i>
                            All Transactions
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-controller="Audit" asp-action="Index" class="btn btn-outline-danger w-100 py-3">
                            <i class="fas fa-clipboard-list d-block mb-2" style="font-size: 24px;"></i>
                            Audit Logs
                        </a>
                    </div>
                </div>

                <!-- Recent Businesses Table -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-building me-2"></i> Recent Businesses
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                        <th>Contact</th>
                                        
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var business in Model)
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">#@business.BusinessID</span></td>
                                                <td class="fw-bold">@business.Name</td>
                                                <td><span class="badge bg-info">@business.Type</span></td>
                                                <td>
                                                    @if (business.Status == "Active")
                                                    {
                                                        <span class="badge bg-success">@business.Status</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">@business.Status</span>
                                                    }
                                                </td>
                                                <td><small>@business.ContactInfo</small></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var business in dummyBusinesses)
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">#@business.BusinessID</span></td>
                                                <td class="fw-bold">@business.Name</td>
                                                <td><span class="badge bg-info">@business.Type</span></td>
                                                <td>
                                                    <span class="badge bg-success">@business.Status</span>
                                                </td>
                                                <td><small>@business.ContactInfo</small></td>
                                                
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
