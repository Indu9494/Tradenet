@{
    Layout = null;
    ViewData["Title"] = "Compliance Review";
    var complianceRecords = ViewBag.ComplianceRecords as IEnumerable<Goverment.Models.ComplianceRecord>;
    var audits = ViewBag.Audits as IEnumerable<Goverment.Models.Audit>;

    // Dummy data for compliance records
    var dummyCompliance = new List<dynamic>
    {
        new { ComplianceID = 1, EntityID = 1, EntityName = "ABC Trading Co.", Type = "License", Result = "Compliant", Date = DateTime.Now.AddDays(-5), Notes = "All documents verified and approved" },
        new { ComplianceID = 2, EntityID = 2, EntityName = "XYZ Imports Ltd.", Type = "License", Result = "Non-Compliant", Date = DateTime.Now.AddDays(-3), Notes = "License expired - renewal required" },
        new { ComplianceID = 3, EntityID = 3, EntityName = "Global Traders Inc.", Type = "Transaction", Result = "Compliant", Date = DateTime.Now.AddDays(-2), Notes = "Transaction records verified" },
        new { ComplianceID = 4, EntityID = 4, EntityName = "Local Market Supply", Type = "Transaction", Result = "Under Review", Date = DateTime.Now.AddDays(-1), Notes = "Large transaction under review" },
        new { ComplianceID = 5, EntityID = 5, EntityName = "Tech Import Solutions", Type = "License", Result = "Compliant", Date = DateTime.Now.AddDays(-6), Notes = "Import license valid" }
    };

    // Dummy data for audits
    var dummyAudits = new List<dynamic>
    {
        new { AuditID = 1, OfficerName = "Trade Officer John", Scope = "License Verification", Findings = "1 license expired - renewal required", Date = DateTime.Now.AddDays(-10), Status = "Completed" },
        new { AuditID = 2, OfficerName = "Compliance Officer Sarah", Scope = "Transaction Review", Findings = "All transactions compliant", Date = DateTime.Now.AddDays(-5), Status = "Completed" },
        new { AuditID = 3, OfficerName = "Auditor Jane", Scope = "Program Audit", Findings = "Budget utilization at 80%", Date = DateTime.Now.AddDays(-2), Status = "In Progress" }
    };

    // Use dummy data if database is empty
    var displayCompliance = (complianceRecords != null && complianceRecords.Any()) ? complianceRecords : null;
    var displayAudits = (audits != null && audits.Any()) ? audits : null;

    var compliantCount = displayCompliance?.Count(c => c.Result == "Compliant" || c.Result == "Pass") ?? dummyCompliance.Count(c => c.Result == "Compliant");
    var nonCompliantCount = displayCompliance?.Count(c => c.Result == "Non-Compliant" || c.Result == "Failed") ?? dummyCompliance.Count(c => c.Result == "Non-Compliant");
    var auditCount = displayAudits?.Count() ?? dummyAudits.Count;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/tradenet.css">
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #003566 0%, #001d3d 100%);
            color: white;
        }
        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.8);
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: all 0.3s;
        }
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
        }
    </style>
</head>
<body class="bg-light" style="overflow-x: hidden;">

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <nav class="col-md-2 d-md-block sidebar p-3 position-fixed" style="height: 100vh; left: 0; top: 0; z-index: 100; overflow-y: hidden;">
                <div class="text-center mb-3 pb-2 border-bottom border-secondary">
                    <h5 class="fw-bold">TradeNet</h5>
                    <p class="small mb-0 text-white-50">Government Auditor</p>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AuditorDashboard" asp-action="Index">
                            <i class="fas fa-chart-line me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AuditorDashboard" asp-action="InvestigationHub">
                            <i class="fas fa-search me-2"></i> Investigation Hub
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="AuditorDashboard" asp-action="ComplianceReview">
                            <i class="fas fa-clipboard-check me-2"></i> Compliance Review
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AuditorDashboard" asp-action="SubsidyTracking">
                            <i class="fas fa-money-bill-wave me-2"></i> Subsidy Tracking
                        </a>
                    </li>
                    <li class="nav-item mt-4">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="nav-link btn btn-link text-start w-100">
                                <i class="fas fa-sign-out-alt me-2"></i> Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </nav>

            <!-- Main Content -->
            <main class="col-md-10 offset-md-2 px-4 py-3" style="margin-left: 16.666667%; width: 83.333333%; max-height: 100vh; overflow-y: auto;">
                <div class="mb-3">
                    <h2 class="fw-bold text-primary">Compliance Review</h2>
                    <p class="text-muted mb-0">Monitor compliance findings and officer adherence to trade policies</p>
                </div>

                <!-- Compliance Statistics -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card shadow-sm border-start border-success border-3 h-100">
                            <div class="card-body bg-light p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted small mb-1">Compliant Records</p>
                                        <h4 class="fw-bold text-success mb-0">@compliantCount</h4>
                                    </div>
                                    <div class="bg-success bg-opacity-10 rounded p-2">
                                        <i class="fas fa-check-circle fa-lg text-success"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm border-start border-danger border-3 h-100">
                            <div class="card-body bg-light p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted small mb-1">Non-Compliant Records</p>
                                        <h4 class="fw-bold text-danger mb-0">@nonCompliantCount</h4>
                                    </div>
                                    <div class="bg-danger bg-opacity-10 rounded p-2">
                                        <i class="fas fa-exclamation-triangle fa-lg text-danger"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm border-start border-primary border-3 h-100">
                            <div class="card-body bg-light p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted small mb-1">Total Audits</p>
                                        <h4 class="fw-bold text-primary mb-0">@auditCount</h4>
                                    </div>
                                    <div class="bg-primary bg-opacity-10 rounded p-2">
                                        <i class="fas fa-clipboard-list fa-lg text-primary"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Compliance Records Table -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-clipboard-check me-2"></i> Compliance Records
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Entity</th>
                                        <th>Type</th>
                                        <th>Result</th>
                                        <th>Date</th>
                                        
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (complianceRecords != null && complianceRecords.Any())
                                    {
                                        @foreach (var record in complianceRecords)
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">#@record.ComplianceID</span></td>
                                                <td>@record.EntityID</td>
                                                <td><span class="badge bg-info">@record.Type</span></td>
                                                <td>
                                                    @if (record.Result == "Compliant" || record.Result == "Pass")
                                                    {
                                                        <span class="badge bg-success">@record.Result</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">@record.Result</span>
                                                    }
                                                </td>
                                                <td>@record.Date.ToString("MMM dd, yyyy")</td>
                                                
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var record in dummyCompliance)
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">#@record.ComplianceID</span></td>
                                                <td>
                                                    <strong>@record.EntityName</strong><br />
                                                    <small class="text-muted">ID: @record.EntityID</small>
                                                </td>
                                                <td><span class="badge bg-info">@record.Type</span></td>
                                                <td>
                                                    @if (record.Result == "Compliant")
                                                    {
                                                        <span class="badge bg-success">@record.Result</span>
                                                    }
                                                    else if (record.Result == "Non-Compliant")
                                                    {
                                                        <span class="badge bg-danger">@record.Result</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">@record.Result</span>
                                                    }
                                                </td>
                                                <td>@record.Date.ToString("MMM dd, yyyy")</td>
                                                
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Audit Activities Table -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-clipboard-list me-2"></i> Audit Activities
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Scope</th>
                                        <th>Officer</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (audits != null && audits.Any())
                                    {
                                        @foreach (var audit in audits)
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">#@audit.AuditID</span></td>
                                                <td>@audit.Scope</td>
                                                <td>@audit.OfficerID</td>
                                                <td>
                                                    @if (audit.Status == "Completed")
                                                    {
                                                        <span class="badge bg-success">@audit.Status</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">@audit.Status</span>
                                                    }
                                                </td>
                                                <td>@audit.Date.ToString("MMM dd, yyyy")</td>
                                                
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var audit in dummyAudits)
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">#@audit.AuditID</span></td>
                                                <td>
                                                    <strong>@audit.Scope</strong><br />
                                                    <small class="text-muted">@audit.Findings</small>
                                                </td>
                                                <td>@audit.OfficerName</td>
                                                <td>
                                                    @if (audit.Status == "Completed")
                                                    {
                                                        <span class="badge bg-success">@audit.Status</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">@audit.Status</span>
                                                    }
                                                </td>
                                                <td>@audit.Date.ToString("MMM dd, yyyy")</td>
                                                
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
