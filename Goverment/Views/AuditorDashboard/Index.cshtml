@{
    Layout = null;
    ViewData["Title"] = "Audit Dashboard";

    // Use ViewBag data or fallback to dummy data (check for 0 or null)
    var totalTransactionAmount = (decimal?)ViewBag.TotalTransactionAmount is null or 0 ? 360000 : (decimal)ViewBag.TotalTransactionAmount;
    var complianceViolations = (int?)ViewBag.ComplianceViolations is null or 0 ? 2 : (int)ViewBag.ComplianceViolations;
    var activeProgramsCount = (int?)ViewBag.ActiveProgramsCount is null or 0 ? 3 : (int)ViewBag.ActiveProgramsCount;
    var totalProgramBudget = (decimal?)ViewBag.TotalProgramBudget is null or 0 ? 2200000 : (decimal)ViewBag.TotalProgramBudget;
    var recentReportsCount = (int?)ViewBag.RecentReportsCount is null or 0 ? 3 : (int)ViewBag.RecentReportsCount;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/tradenet.css">
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #003566 0%, #001d3d 100%);
            color: white;
        }

        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.8);
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: all 0.3s;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .stat-card {
            border-radius: 15px;
            padding: 25px;
            transition: transform 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }
    </style>
</head>
<body class="bg-light" style="overflow-x: hidden;">

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <nav class="col-md-2 d-md-block sidebar p-3 position-fixed" style="height: 100vh; left: 0; top: 0; z-index: 100; overflow-y: hidden;">
                <div class="text-center mb-3 pb-2 border-bottom border-secondary">
                    <h5 class="fw-bold">TradeNet</h5>
                    <p class="small mb-0 text-white-50">Government Auditor</p>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="AuditorDashboard" asp-action="Index">
                            <i class="fas fa-chart-line me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AuditorDashboard" asp-action="InvestigationHub">
                            <i class="fas fa-search me-2"></i> Investigation Hub
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AuditorDashboard" asp-action="ComplianceReview">
                            <i class="fas fa-clipboard-check me-2"></i> Compliance Review
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="AuditorDashboard" asp-action="SubsidyTracking">
                            <i class="fas fa-money-bill-wave me-2"></i> Subsidy Tracking
                        </a>
                    </li>
                    <li class="nav-item mt-4">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="nav-link btn btn-link text-start w-100">
                                <i class="fas fa-sign-out-alt me-2"></i> Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </nav>

            <!-- Main Content -->
            <main class="col-md-10 offset-md-2 px-4 py-3" style="margin-left: 16.666667%; width: 83.333333%; max-height: 100vh; overflow-y: auto;">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="fw-bold text-primary">Audit Dashboard</h2>
                        <p class="text-muted mb-0">Overview of trade health, compliance, and program utilization</p>
                    </div>
                    <div>
                        <span class="badge bg-success px-3 py-2">
                            <i class="fas fa-circle me-1" style="font-size: 8px;"></i> System Active
                        </span>
                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card shadow-sm border-start border-primary border-3 h-100">
                            <div class="card-body bg-light p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted small mb-1">Total Transactions</p>
                                        <h4 class="fw-bold text-primary mb-0">$@totalTransactionAmount.ToString("N0")</h4>
                                    </div>
                                    <div class="bg-primary bg-opacity-10 rounded p-2">
                                        <i class="fas fa-exchange-alt fa-lg text-primary"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-start border-danger border-3 h-100">
                            <div class="card-body bg-light p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted small mb-1">Compliance Violations</p>
                                        <h4 class="fw-bold text-danger mb-0">@complianceViolations</h4>
                                    </div>
                                    <div class="bg-danger bg-opacity-10 rounded p-2">
                                        <i class="fas fa-exclamation-triangle fa-lg text-danger"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-start border-success border-3 h-100">
                            <div class="card-body bg-light p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted small mb-1">Active Programs</p>
                                        <h4 class="fw-bold text-success mb-0">@activeProgramsCount</h4>
                                    </div>
                                    <div class="bg-success bg-opacity-10 rounded p-2">
                                        <i class="fas fa-briefcase fa-lg text-success"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-start border-warning border-3 h-100">
                            <div class="card-body bg-light p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted small mb-1">Program Budget</p>
                                        <h4 class="fw-bold text-warning mb-0">$@totalProgramBudget.ToString("N0")</h4>
                                    </div>
                                    <div class="bg-warning bg-opacity-10 rounded p-2">
                                        <i class="fas fa-dollar-sign fa-lg text-warning"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h5 class="card-title fw-bold text-tn-blue mb-3">
                                    <i class="fas fa-search text-primary me-2"></i> Investigation Hub
                                </h5>
                                <p class="card-text text-muted">Research business history, licenses, and transactions</p>
                                <a asp-controller="AuditorDashboard" asp-action="InvestigationHub" class="btn btn-primary btn-sm">
                                    Start Investigation <i class="fas fa-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h5 class="card-title fw-bold text-tn-blue mb-3">
                                    <i class="fas fa-clipboard-check text-success me-2"></i> Compliance Review
                                </h5>
                                <p class="card-text text-muted">Review compliance findings and officer adherence</p>
                                <a asp-controller="AuditorDashboard" asp-action="ComplianceReview" class="btn btn-success btn-sm">
                                    View Compliance <i class="fas fa-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h5 class="card-title fw-bold text-tn-blue mb-3">
                                    <i class="fas fa-money-bill-wave text-warning me-2"></i> Subsidy Tracking
                                </h5>
                                <p class="card-text text-muted">Monitor trade programs and subsidy utilization</p>
                                <a asp-controller="AuditorDashboard" asp-action="SubsidyTracking" class="btn btn-warning btn-sm text-white">
                                    Track Subsidies <i class="fas fa-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-0 pt-3">
                        <h5 class="fw-bold text-tn-blue mb-0">Recent Reports</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>@recentReportsCount</strong> reports generated
                            <a asp-controller="Report" asp-action="Index" class="alert-link ms-2">View all reports</a>
                        </div>
                        
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
