@model Business

@{
    ViewData["Title"] = "Business Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-building"></i> Business Details</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.BusinessID" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h4>@Model.Name</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Business ID</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">@Model.BusinessID</span>
            </dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">
                <strong>@Model.Name</strong>
            </dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">
                <span class="badge bg-info">@Model.Type</span>
            </dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">
                <i class="bi bi-geo-alt"></i> @Model.Address
            </dd>

            <dt class="col-sm-3">Contact Information</dt>
            <dd class="col-sm-9">
                <i class="bi bi-telephone"></i> @Model.ContactInfo
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge bg-@(Model.Status == "Active" ? "success" : "secondary") fs-6">
                    @Model.Status
                </span>
            </dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.BusinessID" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.BusinessID" class="btn btn-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-list"></i> Back to List
        </a>
    </div>
</div>
