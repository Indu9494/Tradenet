@model Business

@{
    ViewData["Title"] = "Edit Business";
}

<h2>Edit Business</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" asp-for="BusinessID" />
            
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-control" required>
                    <option value="Trader">Trader</option>
                    <option value="Exporter">Exporter</option>
                    <option value="Importer">Importer</option>
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address" class="form-label"></label>
                <textarea asp-for="Address" class="form-control" rows="3" required></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ContactInfo" class="form-label"></label>
                <input asp-for="ContactInfo" class="form-control" required />
                <span asp-validation-for="ContactInfo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-control" required>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Pending">Pending</option>
                    <option value="Suspended">Suspended</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x"></i> Cancel
                </a>
                <a asp-action="Details" asp-route-id="@Model.BusinessID" class="btn btn-info">
                    <i class="bi bi-eye"></i> View Details
                </a>
            </div>
        </form>
    </div>

    <div class="col-md-6">
        <div class="alert alert-warning">
            <h5><i class="bi bi-exclamation-triangle"></i> Important</h5>
            <ul>
                <li>Changes will be applied immediately</li>
                <li>Make sure all information is accurate</li>
                <li>Status changes may affect business operations</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
